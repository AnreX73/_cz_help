{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Помощник самозанятого",
  "version": "0.1.0",
  "identifier": "ru.czhelp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Помощник самозанятого",
        "width": 1240,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Учёт НПД и детализация заказов",
    "longDescription": "Локальный помощник самозанятого: доходы, налог, вычет, лимит и печать детализации заказов с чеком НПД.",
    "windows": {
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}
