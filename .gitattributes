# --- Нормализация переводов строк ---
* text=auto eol=lf

# --- Бинарные файлы ---
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.db binary
*.sqlite binary
*.msi binary
*.exe binary

# --- Windows-скрипты остаются с CRLF ---
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
